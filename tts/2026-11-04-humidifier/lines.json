  "rate": "+12%",
  "lines": [
    {"id": "s1_1", "who": "내레이션", "text": "가습기 청소, 솔 들고 삼십 분 하는 사람?"},
    {"id": "s1_2", "who": "아들", "text": "그거 나야..."},
    {"id": "s2_1", "who": "엄마", "text": "아들, 가습기 또 안 씻었지? 물때 다 꼈더라."},
    {"id": "s2_2", "who": "아들", "text": "아 그거 입구가 좁아서 손이 안 들어가."},
    {"id": "s2_3", "who": "엄마", "text": "요즘 건 물통째로 헹군다던데?"},
    {"id": "s2_4", "who": "아들", "text": "통째로?", "pitch": "+15Hz"},
    {"id": "s3_1", "who": "내레이션", "text": "물통이 통째로 분리돼서, 물로 헹구면 끝. 솔 필요 없어요."},
    {"id": "s4_1", "who": "내레이션", "text": "밤엔 은은한 무드등. 다이얼 하나로 분무량 조절."},
    {"id": "s5_1", "who": "내레이션", "text": "쿠팡 상품평 천육백 개 넘고, 한 달에 천 명 넘게 샀대요."},
    {"id": "s5_2", "who": "아들", "text": "엄마, 나 이거 주문함."},
    {"id": "s5_3", "who": "엄마", "text": "진작 좀 하지!"},
    {"id": "s6_1", "who": "내레이션", "text": "링크는 프로필에! 저장하고 팔로우하면 꿀템 계속 알려드릴게요."}
  ]
}
